laz.dev {
	# laz.dev/latest = "the latest thing I'm proud of". 302 on purpose: the
	# target changes over time, and a 301 gets cached by browsers forever.
	# To repoint: edit the URL below, commit, then
	#   sudo cp Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
	# Old root-level copy of the article; the canonical page lives under /articles/.
	redir /bernie-benchmark.html /articles/bernie-benchmark.html permanent

	@latest path /latest /latest/
	redir @latest https://www.youtube.com/watch?v=GGFTc25-3Mw 302

	handle /api/* {
		reverse_proxy localhost:8000
	}

	handle /claude-code-simulator {
		redir /claude-code-simulator/ permanent
	}

	handle_path /claude-code-simulator/* {
		reverse_proxy localhost:8081
	}

	handle {
		root * /home/laszlokopits/laz.dev/site
		file_server
	}
}
